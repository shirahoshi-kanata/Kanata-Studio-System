# ベースイメージはRunPod公式の安定版
FROM runpod/pytorch:2.2.1-py3.10-cuda12.1.1-devel-ubuntu22.04

# SSHサーバーと必要な通信ツールのインストール
RUN apt-get update && apt-get install -y openssh-server curl && rm -rf /var/lib/apt/lists/*

# SSHデーモンが起動するために必須の空ディレクトリを作成（これがないと即死します）
RUN mkdir -p /var/run/sshd
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

# 作業ディレクトリの設定
WORKDIR /workspace

# UI＋エンジン一体型のPythonスクリプトをコンテナ内にコピー
COPY start_ace_pipeline.py /workspace/start_ace_pipeline.py

# 不沈艦エントリーポイントスクリプトをコピーして実行権限を付与
COPY entrypoint_acestep.sh /entrypoint_acestep.sh
RUN chmod +x /entrypoint_acestep.sh

# コンテナ起動時にエントリーポイントを実行
ENTRYPOINT ["/entrypoint_acestep.sh"]
