FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
RUN pip install --upgrade torch==2.5.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
RUN apt-get update && apt-get install -y wget curl git unzip ffmpeg libgl1-mesa-glx fuse3 && rm -rf /var/lib/apt/lists/*
RUN curl https://rclone.org/install.sh | bash
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir transformers diffusers accelerate gradio huggingface_hub

WORKDIR /workspace
RUN git clone https://github.com/bytedance/Lance.git /workspace/Lance
COPY entrypoint_lance.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["sleep", "infinity"]
